<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- Ids match the FIELD_* constants in source/Recorder.mc. -->
    <fitContributions>
        <!-- Activity summary -->
        <fitField id="0" displayInChart="false" displayInActivitySummary="true" sortOrder="0" dataLabel="@Strings.FitScore" unitLabel="@Strings.FitNoUnit" />
        <fitField id="1" displayInChart="false" displayInActivitySummary="true" sortOrder="1" precision="0" dataLabel="@Strings.FitSetsWon" unitLabel="@Strings.FitSets" />
        <fitField id="2" displayInChart="false" displayInActivitySummary="true" sortOrder="2" precision="0" dataLabel="@Strings.FitSetsLost" unitLabel="@Strings.FitSets" />
        <fitField id="3" displayInChart="false" displayInActivitySummary="true" sortOrder="3" precision="0" dataLabel="@Strings.FitGamesWon" unitLabel="@Strings.FitGames" />
        <fitField id="4" displayInChart="false" displayInActivitySummary="true" sortOrder="4" precision="0" dataLabel="@Strings.FitGamesLost" unitLabel="@Strings.FitGames" />
        <!-- One lap per set -->
        <fitField id="10" displayInChart="false" displayInActivityLaps="true" sortOrder="10" dataLabel="@Strings.FitSetScore" unitLabel="@Strings.FitNoUnit" />
        <fitField id="11" displayInChart="false" displayInActivityLaps="true" sortOrder="11" precision="0" dataLabel="@Strings.FitGamesWon" unitLabel="@Strings.FitGames" />
        <fitField id="12" displayInChart="false" displayInActivityLaps="true" sortOrder="12" precision="0" dataLabel="@Strings.FitGamesLost" unitLabel="@Strings.FitGames" />
    </fitContributions>
</resources>
